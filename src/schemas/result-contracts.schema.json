      "properties": {
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "architecture": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "evidence"
            ],
            "properties": {
