{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-copilot-agents.example/schemas/result-contracts.schema.json",
  "$defs": {
    "route-plan-v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_summary",
        "assumptions",
        "slices",
        "concurrency_groups",
        "allowed_agent_whitelist",
        "excluded_alternatives",
        "approval_checkpoint_state",
        "surface_execution_mode",
        "cloud_session_instructions",
        "completion_gate",
        "unresolved_prerequisites"
      ],
      "properties": {
        "request_summary": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent_id",
              "objective",
              "inputs",
              "contract_id",
              "dependencies",
              "artifact_paths"
            ],
            "properties": {
              "agent_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "objective": {
                "type": "string"
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "contract_id": {
                "type": "string"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "artifact_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "concurrency_groups": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "allowed_agent_whitelist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_checkpoint_state": {
          "enum": [
            "pending",
            "approved",
            "revised",
            "stopped"
          ]
        },
        "surface_execution_mode": {
          "enum": [
            "ide-subagent",
            "cli-delegation",
            "cloud-separate-session"
          ]
        },
        "cloud_session_instructions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent_id",
              "instructions",
              "context_payload"
            ],
            "properties": {
              "agent_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "instructions": {
                "type": "string"
              },
              "context_payload": {
                "type": "string"
              }
            }
          }
        },
        "completion_gate": {
          "type": "string"
        },
        "unresolved_prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subagent_executed": {
          "type": "boolean"
        },
        "delegation_executed": {
          "type": "boolean"
        }
      }
    },
    "stack-analysis-v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stack",
        "architecture",
        "confidence",
        "findings",
        "contradictions",
        "unknowns",
        "recommendations"
