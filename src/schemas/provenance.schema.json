{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "upstream_repository",
    "upstream_commit",
    "source_path",
    "source_blob_sha256",
    "source_dispositions",
    "source_license_spdx",
    "source_license_sha256",
    "source_attribution",
    "adaptation_version",
    "target_id",
    "target_contract_id",
    "procedure_ids",
    "skill_names",
    "resource_destinations",
    "approval_record"
  ],
  "properties": {
    "upstream_repository": { "type": "string", "minLength": 1 },
    "upstream_commit": { "type": "string", "minLength": 40 },
    "source_path": { "type": "string", "minLength": 1 },
    "source_blob_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source_range", "destination", "semantic_status"],
            "properties": {
              "kind": { "const": "source-derived" },
              "source_range": {
                "type": "object",
                "additionalProperties": false,
                "required": ["start_line", "end_line"],
                "properties": {
                  "start_line": { "type": "integer", "minimum": 1 },
                  "end_line": { "type": "integer", "minimum": 1 }
                }
              },
              "destination": { "$ref": "#/$defs/destination" },
              "semantic_status": {
                "type": "string",
                "enum": [
                  "retained",
                  "translated",
                  "consolidated",
                  "corrected",
                  "omitted-for-safety"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "source_range",
              "destination",
              "semantic_status",
              "design_authority"
            ],
            "properties": {
              "kind": { "const": "additive" },
              "source_range": { "type": "null" },
              "destination": { "$ref": "#/$defs/destination" },
              "semantic_status": { "const": "additive" },
              "design_authority": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "source_license_spdx": { "type": "string" },
    "source_license_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_attribution": { "type": "string", "minLength": 1 },
    "adaptation_version": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "target_contract_id": { "type": "string", "minLength": 1 },
    "procedure_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^PROC-[0-9]{2}$" }
    },
    "skill_names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "resource_destinations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "approval_record": { "type": ["string", "null"] }
  },
  "$defs": {
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["profile", "skill", "resource", "contract", "omission-record"]
        },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
